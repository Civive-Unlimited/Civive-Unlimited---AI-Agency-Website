{
  "buildCommand": "pnpm install && pnpm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "cleanUrls": true,
  "installCommand": "pnpm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/resources/ai-search-audit-examples-by-industry",
      "destination": "https://www.civiveunlimited.com/resources/ai-search-audit-patterns-by-industry",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "civiveunlimited.com"
        }
      ],
      "destination": "https://www.civiveunlimited.com/$1",
      "permanent": true
    }
  ]
}
