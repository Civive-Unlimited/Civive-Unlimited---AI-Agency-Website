# Server-only HighLevel integration values.
# Do not expose these as VITE_* variables.
GHL_LOCATION_API_KEY=
GHL_LOCATION_ID=FySiQXrk1tIwqcZOlnYG

# Website leads default to Visibility Report > Report Needed in the live Civive keeper account.
GHL_PIPELINE_ID=9umBLYN4N3tKH4oNEVlx
GHL_PIPELINE_STAGE_ID=b1093f36-c4cf-4aaa-aca5-23faa4b13911

# Public HighLevel Chat Widget ID from the live keeper account:
# Sites > Chat Widget > Install Code.
# This is safe to expose to the browser and powers the native GHL chat widget.
VITE_GHL_CHAT_WIDGET_ID=

# Current live keeper-account GHL Conversation AI website assistant.
GHL_CONVERSATION_AI_AGENT_ID=H6T0jqamZxXyDhRJvs95

# Server-only lead protection.
# The local backup file defaults to output/lead-captures/visibility-report-leads.ndjson
# in local/dev and /tmp/civive-lead-captures/visibility-report-leads.ndjson
# on Vercel. Set CIVIVE_LEAD_BACKUP_DIR only for a server with persistent storage.
CIVIVE_LEAD_BACKUP_DIR=

# Optional durable backup webhook for production lead capture.
# Use an HTTPS endpoint owned by Civive, Make, Zapier, a CRM webhook, or another
# storage sink. This runs before CiviveOS routing so report requests are not lost.
CIVIVE_LEAD_BACKUP_WEBHOOK_URL=

# Optional owner notification webhook. Configure this so Scott receives a
# notification when the website form is submitted, even if CiviveOS routing fails.
CIVIVE_LEAD_NOTIFICATION_WEBHOOK_URL=

# Optional production dry-run guard for /api/lead contract checks.
CIVIVE_LEAD_DRY_RUN_TOKEN=

# Public Google Maps proxy configuration if MapView is used.
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
